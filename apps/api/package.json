{
  "name": "@ivamarg/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "prisma generate && tsup",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "vendus:check": "tsx --env-file=.env src/integrations/vendus.check.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "backup:run": "tsx --env-file=.env -e \"import('./src/jobs/backup.ts').then(m=>m.runBackup()).then(r=>{console.log(r);process.exit(0)})\"",
    "backup:verify": "tsx --env-file=.env scripts/backup-verify.ts",
    "db:restore": "tsx --env-file=.env scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.2",
    "@ivamarg/shared": "*",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "cloudinary": "^2.11.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.0.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pino-pretty": "^13.2.0",
    "pngjs": "^7.0.0",
    "prisma": "~6.19.3",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
