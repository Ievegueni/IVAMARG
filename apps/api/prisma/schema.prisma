generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Acesso e sistema ──────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isAdmin     Boolean  @default(false) // ignora a lista de permissões
  permissions String[] // "módulo.acção" — ver packages/shared/src/permissions.ts
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id               String         @id @default(cuid())
  name             String
  username         String         @unique // usado no login (minúsculas)
  email            String         @unique
  passwordHash     String
  roleId           String
  role             Role           @relation(fields: [roleId], references: [id])
  active           Boolean        @default(true)
  failedLogins     Int            @default(0)
  lockedUntil      DateTime?
  resetTokenHash   String?        @unique
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  sessions         Session[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  clientsOwned     Client[]       @relation("ClientOwner")
  opportunities    Opportunity[]  @relation("OpportunityOwner")
  proposals        Proposal[]     @relation("ProposalOwner")
  approvals        Approval[]
  notifyEmail      Boolean        @default(true) // preferência: notificações também por email
  tasksAssigned    Task[]         @relation("TaskAssignee")
  phone            String? // para alertas por WhatsApp/SMS
  /// Permissões concedidas a este utilizador além das do perfil (grupo).
  extraPermissions String[]       @default([])
  conversations    Conversation[] @relation("ConversationAssignee")
  callLogs         CallLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdById      String?
}

/// Refresh token opaco (cookie httpOnly), guardado como hash e rodado a cada refresh.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tokenHash     String    @unique
  /// Token anterior aceite durante uns segundos após rodar (resposta perdida não termina a sessão).
  prevTokenHash String?
  rotatedAt     DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([prevTokenHash])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String?
  action    String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key         String   @id
  value       Json
  label       String
  description String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  label       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Numeração sequencial por chave (ex.: "PROP-2026").
model Sequence {
  key   String @id
  value Int
}

/// Mapeamento para sistemas externos (ex.: Vendus).
model ExternalRef {
  id         String   @id @default(cuid())
  entity     String // Client, ProductModel
  entityId   String
  system     String // vendus
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entity, entityId, system])
}

model IntegrationLog {
  id         String   @id @default(cuid())
  system     String // vendus, meta, futurix, smtp, cloudinary
  operation  String
  status     String // success | error
  request    Json?
  response   Json?
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([system, createdAt])
}

// ─── Configuração de negócio (backoffice) ──────────────────────────

/// O tipo define o que uma proposta aceite gera (CLAUDE.md §5.5). O nome é editável.
enum BusinessLineKind {
  CONSTRUCTION
  UNIFORMS
  CLEANING
  BOREHOLE
}

model BusinessLine {
  id             String           @id @default(cuid())
  name           String
  kind           BusinessLineKind
  active         Boolean          @default(true)
  order          Int              @default(0)
  pipelineStages PipelineStage[]
  clients        Client[]
  opportunities  Opportunity[]
  proposals      Proposal[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model PipelineStage {
  id             String        @id @default(cuid())
  businessLineId String
  businessLine   BusinessLine  @relation(fields: [businessLineId], references: [id])
  name           String
  order          Int
  isWon          Boolean       @default(false)
  isLost         Boolean       @default(false)
  active         Boolean       @default(true)
  opportunities  Opportunity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessLineId, order])
}

/// QUALITY = ponto de inspecção (aprovadas seguem, retrabalho volta a uma etapa, refugo sai).
enum StageType {
  INTERNAL
  EXTERNAL
  QUALITY
}

model ProductionSection {
  id        String            @id @default(cuid())
  name      String            @unique
  active    Boolean           @default(true)
  stages    ProductionStage[]
  operators Operator[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProductionStage {
  id            String             @id @default(cuid())
  name          String
  order         Int
  type          StageType          @default(INTERNAL)
  sectionId     String?
  section       ProductionSection? @relation(fields: [sectionId], references: [id])
  active        Boolean            @default(true)
  logs          StageLog[]         @relation("LogStage")
  reworkLogs    StageLog[]         @relation("ReworkStage")
  rates         StageRate[]
  standardTimes StandardTime[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model DefectType {
  id        String             @id @default(cuid())
  name      String             @unique
  active    Boolean            @default(true)
  defects   InspectionDefect[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ─── Comercial ─────────────────────────────────────────────────────

model Client {
  id            String          @id @default(cuid())
  name          String
  nif           String?
  phones        String[] // normalizados (só dígitos, 244…)
  email         String?
  address       String?
  notes         String?
  tags          String[]
  ownerId       String? // comercial responsável
  owner         User?           @relation("ClientOwner", fields: [ownerId], references: [id])
  businessLines BusinessLine[]
  contacts      ClientContact[]
  timeline      TimelineEvent[]
  opportunities Opportunity[]
  proposals     Proposal[]
  orders        Order[]
  contracts     Contract[]
  projects      Project[]
  boreholes     Borehole[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?
  deletedAt     DateTime?

  @@index([nif])
  @@index([email])
  @@index([ownerId])
}

model ClientContact {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/// Histórico unificado do cliente. Qualquer módulo acrescenta eventos (entity/entityId apontam para a origem).
model TimelineEvent {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  type       String // NOTE, CALL, MEETING, VISIT, EMAIL (manuais) | SYSTEM
  title      String
  body       String?
  entity     String?
  entityId   String?
  userId     String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([clientId, occurredAt])
}

model Opportunity {
  id              String        @id @default(cuid())
  title           String
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  businessLineId  String
  businessLine    BusinessLine  @relation(fields: [businessLineId], references: [id])
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  value           Int           @default(0)
  ownerId         String?
  owner           User?         @relation("OpportunityOwner", fields: [ownerId], references: [id])
  expectedCloseAt DateTime?     @db.Date
  source          String?
  lostReason      String?
  closedAt        DateTime?
  notes           String?
  proposals       Proposal[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  deletedAt       DateTime?

  @@index([businessLineId, stageId])
  @@index([ownerId])
}

enum ProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  DECLINED
}

model Proposal {
  id             String            @id @default(cuid())
  number         String            @unique
  title          String
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?      @relation(fields: [opportunityId], references: [id])
  businessLineId String
  businessLine   BusinessLine      @relation(fields: [businessLineId], references: [id])
  ownerId        String?
  owner          User?             @relation("ProposalOwner", fields: [ownerId], references: [id])
  mode           String            @default("ITEMS") // ITEMS | PHASES (obras)
  status         ProposalStatus    @default(DRAFT)
  currentVersion Int               @default(1)
  total          Int               @default(0) // da versão actual
  acceptedAt     DateTime?
  declineReason  String?
  versions       ProposalVersion[]
  order          Order?
  contract       Contract?
  project        Project?
  borehole       Borehole?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([clientId])
  @@index([status])
}

/// Imutável depois de enviada (sentAt preenchido).
model ProposalVersion {
  id          String         @id @default(cuid())
  proposalId  String
  proposal    Proposal       @relation(fields: [proposalId], references: [id])
  version     Int
  notes       String?
  validUntil  DateTime?      @db.Date
  total       Int            @default(0)
  sentAt      DateTime?
  items       ProposalItem[]
  approvals   Approval[]
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([proposalId, version])
}

model ProposalItem {
  id          String          @id @default(cuid())
  versionId   String
  version     ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal         @db.Decimal(12, 3)
  unitPrice   Int
  discountPct Decimal         @default(0) @db.Decimal(5, 2)
  total       Int
}

model Approval {
  id         String          @id @default(cuid())
  versionId  String
  version    ProposalVersion @relation(fields: [versionId], references: [id])
  approverId String
  approver   User            @relation(fields: [approverId], references: [id])
  decision   String // APPROVED | REJECTED
  comment    String?
  createdAt  DateTime        @default(now())
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id                   String            @id @default(cuid())
  number               String            @unique
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id])
  proposalId           String?           @unique
  proposal             Proposal?         @relation(fields: [proposalId], references: [id])
  deadline             DateTime?         @db.Date
  priority             Priority          @default(NORMAL)
  status               OrderStatus       @default(DRAFT)
  personalizationName  String?
  personalizationNotes String?
  notes                String?
  total                Int               @default(0)
  lines                OrderLine[]
  productionOrders     ProductionOrder[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdById          String?
  deletedAt            DateTime?

  @@index([clientId])
  @@index([status])
}

model OrderLine {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  productModelId String?
  productModel   ProductModel?         @relation(fields: [productModelId], references: [id])
  sizeGrid       Json                  @default("{}") // { "S": 10, "M": 25 }
  color          String?
  details        String?
  quantity       Int
  unitPrice      Int
  total          Int
  poItems        ProductionOrderItem[]
}

enum Periodicity {
  ONE_TIME
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

model Contract {
  id                String         @id @default(cuid())
  number            String         @unique
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  proposalId        String?        @unique
  proposal          Proposal?      @relation(fields: [proposalId], references: [id])
  businessLineId    String?
  title             String
  startDate         DateTime       @db.Date
  endDate           DateTime?      @db.Date
  value             Int
  periodicity       Periodicity
  autoRenew         Boolean        @default(false)
  renewalNoticeDays Int            @default(30)
  status            ContractStatus @default(ACTIVE)
  notes             String?
  visits            ServiceVisit[]
  /// Planeamento das visitas (limpeza/jardinagem): dias da semana (1=seg … 7=dom), hora, equipa
  visitDays         Int[]
  visitTime         String? // "08:00"
  visitTeam         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?
  deletedAt         DateTime?

  @@index([clientId])
}

// ─── Operações (base; detalhe no S6) ───────────────────────────────

/// Obra (construção civil / obras públicas).
model Project {
  id          String         @id @default(cuid())
  number      String         @unique
  name        String
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  proposalId  String?        @unique
  proposal    Proposal?      @relation(fields: [proposalId], references: [id])
  description String?
  location    String?
  budget      Int            @default(0)
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  status      String         @default("PLANNED") // PLANNED, IN_PROGRESS, SUSPENDED, COMPLETED, CANCELLED
  managerId   String?
  team        String[] // ids de utilizadores
  crew        String? // equipa externa / operários (texto livre)
  phases      ProjectPhase[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  deletedAt   DateTime?
}

/// Fase/etapa de obra ou de furo (entity = Project | Borehole).
model ProjectPhase {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  boreholeId   String?
  borehole     Borehole? @relation(fields: [boreholeId], references: [id])
  name         String
  order        Int
  budget       Int       @default(0)
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, DONE
  progress     Int       @default(0) // %
  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?

  @@index([projectId])
  @@index([boreholeId])
}

/// Furo de água.
model Borehole {
  id          String         @id @default(cuid())
  number      String         @unique
  name        String
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  proposalId  String?        @unique
  proposal    Proposal?      @relation(fields: [proposalId], references: [id])
  description String?
  budget      Int            @default(0)
  location    String?
  gps         String? // "lat,long"
  status      String         @default("PLANNED")
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  managerId   String?
  team        String[]
  crew        String?
  /// Resultado: profundidade, caudal, nível estático/dinâmico… (campos livres)
  result      Json           @default("{}")
  phases      ProjectPhase[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  deletedAt   DateTime?
}

// ─── Stock ─────────────────────────────────────────────────────────

enum StockCategory {
  RAW_MATERIAL
  CONSTRUCTION
  CONSUMABLE
}

model StockItem {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String
  category       StockCategory         @default(RAW_MATERIAL)
  unit           String // m, kg, un, rolo…
  avgCost        Decimal               @default(0) @db.Decimal(14, 4) // custo médio ponderado por unidade (Kz)
  minStock       Decimal               @default(0) @db.Decimal(12, 3)
  active         Boolean               @default(true)
  levels         StockLevel[]
  movements      StockMovement[]
  bomLines       BomLine[]
  purchaseLines  PurchaseLine[]
  inventoryLines InventoryLine[]
  requirements   MaterialRequirement[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdById    String?
  deletedAt      DateTime?
}

model Warehouse {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  active      Boolean         @default(true)
  levels      StockLevel[]
  movements   StockMovement[] @relation("MovementWarehouse")
  transfersIn StockMovement[] @relation("MovementToWarehouse")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Stock disponível = onHand − reserved.
model StockLevel {
  id          String    @id @default(cuid())
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  onHand      Decimal   @default(0) @db.Decimal(12, 3)
  reserved    Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, warehouseId])
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RESERVE
  RELEASE
}

/// Histórico imutável. quantity > 0 excepto ADJUSTMENT (pode ser negativo).
model StockMovement {
  id            String       @id @default(cuid())
  type          MovementType
  itemId        String
  item          StockItem    @relation(fields: [itemId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  toWarehouseId String?
  toWarehouse   Warehouse?   @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  quantity      Decimal      @db.Decimal(12, 3)
  unitCost      Decimal?     @db.Decimal(14, 4)
  sourceType    String // PURCHASE, PRODUCTION_ORDER, PROJECT, INVENTORY, MANUAL
  sourceId      String?
  notes         String?
  userId        String?
  createdAt     DateTime     @default(now())

  @@index([itemId, createdAt])
  @@index([sourceType, sourceId])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  nif         String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  purchases   Purchase[]
  stageLogs   StageLog[]
  payables    Payable[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  deletedAt   DateTime?
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Purchase {
  id          String         @id @default(cuid())
  number      String         @unique
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId String
  status      PurchaseStatus @default(DRAFT)
  expectedAt  DateTime?      @db.Date
  receivedAt  DateTime?
  total       Int            @default(0)
  notes       String?
  lines       PurchaseLine[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  deletedAt   DateTime?
}

model PurchaseLine {
  id         String    @id @default(cuid())
  purchaseId String
  purchase   Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       StockItem @relation(fields: [itemId], references: [id])
  quantity   Decimal   @db.Decimal(12, 3)
  unitCost   Int
  total      Int
}

enum InventoryStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

model InventoryCount {
  id           String          @id @default(cuid())
  number       String          @unique
  warehouseId  String
  status       InventoryStatus @default(OPEN)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  lines        InventoryLine[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?
}

model InventoryLine {
  id       String         @id @default(cuid())
  countId  String
  count    InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId   String
  item     StockItem      @relation(fields: [itemId], references: [id])
  expected Decimal        @db.Decimal(12, 3) // físico no momento da contagem
  counted  Decimal?       @db.Decimal(12, 3)

  @@unique([countId, itemId])
}

// ─── Catálogo / ficha técnica ──────────────────────────────────────

model ProductModel {
  id            String                @id @default(cuid())
  reference     String                @unique
  name          String
  basePrice     Int                   @default(0)
  description   String?
  photos        String[] // data URLs (até haver Cloudinary)
  active        Boolean               @default(true)
  bom           BomLine[]
  standardTimes StandardTime[]
  rates         StageRate[]
  orderLines    OrderLine[]
  poItems       ProductionOrderItem[]
  lots          Lot[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  createdById   String?
  deletedAt     DateTime?
}

/// Consumo por peça. size null = vale para todos os tamanhos sem linha específica.
model BomLine {
  id             String       @id @default(cuid())
  productModelId String
  productModel   ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      StockItem    @relation(fields: [stockItemId], references: [id])
  size           String?
  consumption    Decimal      @db.Decimal(12, 3)

  @@unique([productModelId, stockItemId, size])
}

model StandardTime {
  id              String          @id @default(cuid())
  productModelId  String
  productModel    ProductModel    @relation(fields: [productModelId], references: [id], onDelete: Cascade)
  stageId         String
  stage           ProductionStage @relation(fields: [stageId], references: [id])
  minutesPerPiece Decimal         @db.Decimal(8, 2)

  @@unique([productModelId, stageId])
}

// ─── Operadores ────────────────────────────────────────────────────

enum PayModel {
  FIXED
  PIECE
  MIXED
}

model Operator {
  id          String             @id @default(cuid())
  name        String
  code        String             @unique
  pinHash     String?
  pinLookup   String?            @unique // HMAC do PIN para encontrar o operador só pelo PIN
  sectionId   String?
  section     ProductionSection? @relation(fields: [sectionId], references: [id])
  payModel    PayModel           @default(PIECE)
  fixedSalary Int                @default(0) // mensal, Kz
  active      Boolean            @default(true)
  logs        StageLog[]
  employee    Employee?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Valor pago por peça concluída numa etapa (opcionalmente específico de um modelo).
model StageRate {
  id             String          @id @default(cuid())
  stageId        String
  stage          ProductionStage @relation(fields: [stageId], references: [id])
  productModelId String?
  productModel   ProductModel?   @relation(fields: [productModelId], references: [id])
  rate           Int

  @@unique([stageId, productModelId])
}

// ─── Produção ──────────────────────────────────────────────────────

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id           String                @id @default(cuid())
  number       String                @unique
  orderId      String
  order        Order                 @relation(fields: [orderId], references: [id])
  warehouseId  String // armazém de onde sai o material
  status       ProductionOrderStatus @default(DRAFT)
  releasedAt   DateTime?
  completedAt  DateTime?
  notes        String?
  items        ProductionOrderItem[]
  requirements MaterialRequirement[]
  lots         Lot[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdById  String?
}

model ProductionOrderItem {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  orderLineId       String
  orderLine         OrderLine       @relation(fields: [orderLineId], references: [id])
  productModelId    String
  productModel      ProductModel    @relation(fields: [productModelId], references: [id])
  sizeGrid          Json
  quantity          Int
}

/// Necessidade teórica (BOM) gravada ao libertar a OP; reservado/consumido acompanham os movimentos.
model MaterialRequirement {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String
  item              StockItem       @relation(fields: [itemId], references: [id])
  required          Decimal         @db.Decimal(12, 3)
  reserved          Decimal         @default(0) @db.Decimal(12, 3)
  issued            Decimal         @default(0) @db.Decimal(12, 3)
  issuedCost        Int             @default(0)

  @@unique([productionOrderId, itemId])
}

enum LotStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Lot {
  id                String          @id @default(cuid())
  number            String          @unique
  qrToken           String          @unique
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  productModelId    String
  productModel      ProductModel    @relation(fields: [productModelId], references: [id])
  size              String?
  quantity          Int
  status            LotStatus       @default(OPEN)
  logs              StageLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

/// Registo de uma etapa num lote. Interna: operador. Externa: fornecedor (envio = início, retorno = fim).
/// Qualidade: qtyDone = aprovadas, qtyRejected = refugo, qtyRework volta a reworkStage.
model StageLog {
  id            String             @id @default(cuid())
  lotId         String
  lot           Lot                @relation(fields: [lotId], references: [id])
  stageId       String
  stage         ProductionStage    @relation("LogStage", fields: [stageId], references: [id])
  operatorId    String?
  operator      Operator?          @relation(fields: [operatorId], references: [id])
  supplierId    String?
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  qtyIn         Int
  qtyDone       Int                @default(0)
  qtyRejected   Int                @default(0)
  qtyRework     Int                @default(0)
  reworkStageId String?
  reworkStage   ProductionStage?   @relation("ReworkStage", fields: [reworkStageId], references: [id])
  cost          Int                @default(0) // custo externo
  labourCost    Int                @default(0) // qtyDone × valor por peça, fixado ao concluir
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  notes         String?
  defects       InspectionDefect[]
  userId        String?
  createdAt     DateTime           @default(now())

  @@index([lotId, stageId])
  @@index([operatorId, finishedAt])
}

model InspectionDefect {
  id           String     @id @default(cuid())
  stageLogId   String
  stageLog     StageLog   @relation(fields: [stageLogId], references: [id], onDelete: Cascade)
  defectTypeId String
  defectType   DefectType @relation(fields: [defectTypeId], references: [id])
  quantity     Int
}

// ─── Tarefas e agenda ──────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  assignee    User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueAt       DateTime?
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  entity      String? // Client, Opportunity, Order, Project…
  entityId    String?
  clientId    String? // para a timeline
  remindedAt  DateTime? // último lembrete enviado
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([assigneeId, status])
  @@index([dueAt])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("MEETING") // MEETING, VISIT, APPOINTMENT, OTHER
  startAt     DateTime
  endAt       DateTime
  location    String?
  attendeeIds String[]
  clientId    String?
  entity      String?
  entityId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([startAt])
}

// ─── Gestão documental ─────────────────────────────────────────────

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  parentId  String?
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

/// roleIds vazio = visível a quem tem documents.view; senão só a esses perfis (e administradores).
model DocumentCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  roleIds   String[]
  active    Boolean    @default(true)
  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Document {
  id             String            @id @default(cuid())
  title          String
  description    String?
  categoryId     String
  category       DocumentCategory  @relation(fields: [categoryId], references: [id])
  folderId       String?
  folder         DocumentFolder?   @relation(fields: [folderId], references: [id])
  tags           String[]
  issuedAt       DateTime?         @db.Date
  expiresAt      DateTime?         @db.Date
  currentVersion Int               @default(1)
  versions       DocumentVersion[]
  links          DocumentLink[]
  lastAlertDays  Int? // último limiar de validade notificado
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([expiresAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  version      Int
  storageKey   String
  filename     String
  mime         String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
}

model DocumentLink {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  entity     String // Client, Opportunity, Proposal, Contract, Order, ProductionOrder, Project, Borehole, Supplier, User
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([documentId, entity, entityId])
  @@index([entity, entityId])
}

// ─── Facturação (Vendus) ───────────────────────────────────────────

enum InvoiceStatus {
  PENDING // na fila
  ISSUED
  FAILED
  CANCELLED
}

model Invoice {
  id               String        @id @default(cuid())
  clientId         String
  orderId          String?
  proposalId       String?
  contractId       String?
  status           InvoiceStatus @default(PENDING)
  documentType     String        @default("FT")
  total            Int
  dueDate          DateTime?     @db.Date
  vendusDocumentId String?
  number           String? // número fiscal atribuído pelo Vendus
  issuedAt         DateTime?
  error            String?
  items            Json // linhas enviadas (descrição, qtd, preço)
  businessLineId   String?
  sellerId         String? // comercial (para comissões)
  receivable       Receivable?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      String?

  @@index([clientId])
  @@index([orderId])
}

// ─── Comunicação ───────────────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  MESSENGER
  INSTAGRAM
  EMAIL
  SMS
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// Uma conversa por canal + contacto externo (telefone, PSID/IGSID, email).
model Conversation {
  id            String             @id @default(cuid())
  channel       ChannelType
  externalId    String
  contactName   String?
  clientId      String?
  assigneeId    String?
  assignee      User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  lastInboundAt DateTime? // abre a janela de 24h
  callConsentAt DateTime? // cliente autorizou chamadas da empresa (WhatsApp)
  calls         CallLog[]
  unread        Int                @default(0)
  messages      Message[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([channel, externalId])
  @@index([clientId])
  @@index([status, lastMessageAt])
}

enum MessageDirection {
  IN
  OUT
  NOTE
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  type           String           @default("TEXT") // TEXT, IMAGE, DOCUMENT, AUDIO, VIDEO, TEMPLATE, NOTE
  body           String?
  mediaId        String? // id do media na Meta (recebidos)
  mediaUrl       String? // enviado por link
  templateId     String?
  templateVars   Json? // valores das variáveis (parâmetros do template WhatsApp)
  externalId     String?          @unique // wamid / mid — evita duplicados de webhooks repetidos
  status         String           @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED, RECEIVED, SIMULATED
  error          String?
  userId         String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model MessageTemplate {
  id             String        @id @default(cuid())
  name           String        @unique
  channels       ChannelType[]
  subject        String?
  body           String
  waTemplateName String?
  waLanguage     String        @default("pt_PT")
  active         Boolean       @default(true)
  automations    Automation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Automation {
  id         String          @id @default(cuid())
  name       String
  trigger    String // PROPOSAL_SENT, ORDER_READY, PAYMENT_OVERDUE, TASK_DUE, DOCUMENT_EXPIRING
  channel    ChannelType
  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id])
  recipient  String // CLIENT, ASSIGNEE, DIRECTION
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ─── Financeiro ────────────────────────────────────────────────────

/// Conta a receber: criada quando a factura é emitida no Vendus (ou manualmente).
model Receivable {
  id                String    @id @default(cuid())
  clientId          String
  invoiceId         String?   @unique
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id])
  description       String
  amount            Int
  paid              Int       @default(0)
  dueDate           DateTime? @db.Date
  businessLineId    String?
  overdueNotifiedAt DateTime?
  payments          Payment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  deletedAt         DateTime?

  @@index([clientId])
  @@index([dueDate])
}

model Payment {
  id           String     @id @default(cuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])
  amount       Int
  method       String // TRANSFER, CASH, TPA, CHEQUE, OTHER
  paidAt       DateTime   @db.Date
  reference    String?
  notes        String?
  userId       String?
  createdAt    DateTime   @default(now())
  cancelledAt  DateTime?

  @@index([paidAt])
}

model EntryCategory {
  id       String           @id @default(cuid())
  name     String
  type     String // INCOME | EXPENSE
  active   Boolean          @default(true)
  entries  FinancialEntry[]
  payables Payable[]

  @@unique([name, type])
}

/// Receitas e despesas. Recebimentos de clientes geram receitas automaticamente.
model FinancialEntry {
  id                String        @id @default(cuid())
  type              String // INCOME | EXPENSE
  categoryId        String
  category          EntryCategory @relation(fields: [categoryId], references: [id])
  amount            Int
  date              DateTime      @db.Date
  description       String
  businessLineId    String?
  entity            String? // centro de custo: Order, Project, Borehole, Contract
  entityId          String?
  supplierId        String?
  paymentId         String?       @unique
  supplierPaymentId String?       @unique // pagamento a fornecedor/prestador (automático)
  salaryPaymentId   String?       @unique // pagamento de salário (automático)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  deletedAt         DateTime?

  @@index([type, date])
  @@index([entity, entityId])
}

model CommissionRule {
  id             String       @id @default(cuid())
  name           String
  type           String // PERCENT | FIXED
  value          Decimal      @db.Decimal(12, 2)
  base           String // INVOICED | RECEIVED
  userId         String?
  businessLineId String?
  productModelId String?
  active         Boolean      @default(true)
  commissions    Commission[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Commission {
  id         String          @id @default(cuid())
  userId     String
  period     String // AAAA-MM
  sourceType String // Invoice | Payment
  sourceId   String
  ruleId     String?
  rule       CommissionRule? @relation(fields: [ruleId], references: [id])
  baseAmount Int
  amount     Int
  status     String          @default("CALCULATED") // CALCULATED, APPROVED, PAID
  approvedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sourceType, sourceId, userId])
  @@index([period, userId])
}

// ─── KPIs e relatórios ─────────────────────────────────────────────

model KpiDefinition {
  key     String      @id
  name    String
  unit    String // %, pç, dias, Kz, h
  higher  Boolean     @default(true) // maior é melhor
  active  Boolean     @default(true)
  targets KpiTarget[]
}

model KpiTarget {
  id     String        @id @default(cuid())
  kpiKey String
  kpi    KpiDefinition @relation(fields: [kpiKey], references: [key])
  userId String? // meta individual (vazio = empresa)
  value  Decimal       @db.Decimal(14, 2)

  @@unique([kpiKey, userId])
}

model Report {
  id         String   @id @default(cuid())
  type       String
  format     String // pdf | xlsx
  filters    Json
  status     String   @default("PENDING") // PENDING, READY, FAILED
  storageKey String?
  filename   String?
  error      String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Visita de limpeza/jardinagem planeada a partir do contrato; registo de execução.
model ServiceVisit {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id])
  scheduledAt DateTime
  team        String?
  status      String    @default("PLANNED") // PLANNED, DONE, MISSED, CANCELLED
  executedAt  DateTime?
  notes       String?
  checklist   Json      @default("[]") // [{ item, done }]
  userId      String? // quem registou
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contractId, scheduledAt])
  @@index([scheduledAt])
}

/// Chamada WhatsApp (Cloud API Calling). Atrás da flag whatsapp.calls.
model CallLog {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  externalId     String?      @unique // call id Meta
  direction      String // IN | OUT
  status         String       @default("RINGING") // RINGING, ACCEPTED, ENDED, MISSED, REJECTED, FAILED
  offerSdp       String? // SDP recebido (chamada recebida) / enviado (efectuada)
  answerSdp      String?
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  startedAt      DateTime     @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  result         String? // notas / resultado
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([status])
}

// ── RH ──

model Employee {
  id                 String       @id @default(cuid())
  number             String       @unique // FUN-0001
  name               String
  bi                 String?
  nif                String?
  inssNumber         String?
  birthDate          DateTime?
  phone              String?
  email              String?
  address            String?
  position           String
  department         String?
  hireDate           DateTime
  contractType       String       @default("EFFECTIVE")
  contractEnd        DateTime?
  baseSalary         Int          @default(0)
  mealAllowance      Int          @default(0)
  transportAllowance Int          @default(0)
  otherAllowances    Int          @default(0)
  vacationDays       Int          @default(22) // dias úteis por ano
  bank               String?
  iban               String?
  status             String       @default("ACTIVE")
  operatorId         String?      @unique // ligação ao operador da fábrica (produção à peça)
  biometricId        String?      @unique // n.º do trabalhador no relógio biométrico (sJobNo)
  operator           Operator?    @relation(fields: [operatorId], references: [id])
  notes              String?
  attendance         Attendance[]
  leaves             Leave[]
  payslips           Payslip[]
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime @db.Date
  status        String // PRESENT, LATE, ABSENT, JUSTIFIED, VACATION, SICK, HOLIDAY
  checkIn       String? // HH:MM
  checkOut      String?
  overtimeHours Float    @default(0)
  notes         String?
  leaveId       String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model Leave {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  type           String    @default("VACATION")
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  days           Int // dias úteis
  status         String    @default("PENDING")
  reason         String?
  attachmentKey  String? // documento justificativo (storage)
  attachmentName String?
  attachmentMime String?
  decidedById    String?
  decidedAt      DateTime?
  comment        String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId, startDate])
}

model PayrollRun {
  id           String    @id @default(cuid())
  period       String    @unique // AAAA-MM
  status       String    @default("DRAFT")
  rules        Json // regras usadas no cálculo (INSS, IRT...) para o recibo ser reproduzível
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  payslips     Payslip[]
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Payslip {
  id                 String          @id @default(cuid())
  runId              String
  run                PayrollRun      @relation(fields: [runId], references: [id])
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id])
  baseSalary         Int
  mealAllowance      Int
  transportAllowance Int
  otherAllowances    Int
  overtimeHours      Float           @default(0)
  overtimePay        Int             @default(0)
  absences           Int             @default(0)
  absenceDeduction   Int             @default(0)
  piecePay           Int             @default(0)
  bonus              Int             @default(0)
  otherDeductions    Int             @default(0)
  gross              Int
  inssEmployee       Int
  inssEmployer       Int
  irt                Int
  net                Int
  paid               Int             @default(0) // pago ao trabalhador (pagamentos parcelados)
  payments           SalaryPayment[]
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([runId, employeeId])
}

// Dívidas a fornecedores / prestadores de serviço (compras e serviços a pagar).
model Payable {
  id             String            @id @default(cuid())
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  categoryId     String
  category       EntryCategory     @relation(fields: [categoryId], references: [id])
  description    String
  reference      String? // n.º da factura do fornecedor
  amount         Int
  paid           Int               @default(0)
  date           DateTime          @db.Date
  dueDate        DateTime?         @db.Date
  businessLineId String?
  entity         String? // centro de custo, como em FinancialEntry
  entityId       String?
  payments       SupplierPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  deletedAt      DateTime?

  @@index([supplierId])
  @@index([dueDate])
}

model SupplierPayment {
  id          String    @id @default(cuid())
  payableId   String
  payable     Payable   @relation(fields: [payableId], references: [id])
  amount      Int
  method      String
  paidAt      DateTime  @db.Date
  reference   String?
  notes       String?
  userId      String?
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([paidAt])
}

model SalaryPayment {
  id          String    @id @default(cuid())
  payslipId   String
  payslip     Payslip   @relation(fields: [payslipId], references: [id])
  amount      Int
  method      String
  paidAt      DateTime  @db.Date
  reference   String?
  userId      String?
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([payslipId])
}
